APP_ENV=development
LOG_LEVEL=INFO
PORT=8100
MAX_UPLOAD_SIZE_MB=25

# Table extraction (default true since Fase 4; false returns no tables and no invoice line items)
ENABLE_TABLE_EXTRACTOR=true
# Candidate generation + LightGBM scoring on /v1/extract/pipeline/full (additive "ml_extraction")
ENABLE_ML_EXTRACTION=true
# ML_MODEL_SET_DIR=/app/models/pod_phase2   (default: <ai-service>/models/pod_phase2, independent of the working directory)
PAGE_OUTPUT_DIR=out/pages
PAGE_RETENTION_HOURS=24
# Raster OCR (PaddleOCR). Empty = PaddleOCR 3.7 defaults for lang=en (PP-OCRv6 medium det+rec, 133 MB, about 70 s per scan page on CPU). PP-OCRv5 mobile (12 MB) is about 3x faster:
# PADDLE_DET_MODEL=PP-OCRv5_mobile_det
# PADDLE_REC_MODEL=en_PP-OCRv5_mobile_rec
# PADDLE_DET_LIMIT_SIDE_LEN=1280
