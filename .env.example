APP_ENV=development
LOG_LEVEL=INFO
PORT=8100
OCR_ENGINE=pp-ocr-v6
OCR_FALLBACK_ENGINE=paddleocr-vl-1.6
MAX_UPLOAD_SIZE_MB=25

# Table extraction (default true since Fase 4; false returns no tables and no invoice line items)
ENABLE_TABLE_EXTRACTOR=true
# Candidate generation + LightGBM scoring on /v1/extract/pipeline/full (additive "ml_extraction")
ENABLE_ML_EXTRACTION=true
ML_MODEL_SET_DIR=models/pod_phase2
